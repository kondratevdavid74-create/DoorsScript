-- // Function to Create Toggles
local function CreateToggle(name, yPos, callback)
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Size = UDim2.new(1, -20, 0, 35)
    ToggleButton.Position = UDim2.new(0, 10, 0, yPos)
    ToggleButton.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    ToggleButton.Text = "  " .. name .. ": [ OFF ]"
    ToggleButton.TextColor3 = Color3.fromRGB(180, 180, 190)
    ToggleButton.TextXAlignment = Enum.TextXAlignment.Left
    ToggleButton.Font = Enum.Font.GothamMedium
    ToggleButton.TextSize = 12
    ToggleButton.Parent = MainFrame
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = ToggleButton
    
    local state = false
    ToggleButton.MouseButton1Click:Connect(function()
        state = not state
        if state then
            ToggleButton.Text = "  " .. name .. ": [ ON ]"
            ToggleButton.TextColor3 = Color3.fromRGB(90, 255, 140)
        else
            ToggleButton.Text = "  " .. name .. ": [ OFF ]"
            ToggleButton.TextColor3 = Color3.fromRGB(180, 180, 190)
        end
        callback(state)
    end)
end

-- // ESP Engine
local espCache = {}
local function createHighlight(target, color)
    if espCache[target] then return end
    local highlight = Instance.new("Highlight")
    highlight.Adornee = target
    highlight.FillColor = color
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.5
    highlight.Parent = CoreGui
    espCache[target] = highlight
end

local function clearESP()
    for obj, highlight in pairs(espCache) do
        if highlight then highlight:Destroy() end
    end
    espCache = {}
end

