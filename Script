-- // Main Processing Loop (Optimized with Heartbeat)
RunService.Heartbeat:Connect(function(dt)
    -- Speed Changer with CFrame / Velocity Blending Bypass
    if Config.SpeedChanger.Enabled then
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
            local humanoid = character.Humanoid
            local hrp = character.HumanoidRootPart
            
            if humanoid.MoveDirection.Magnitude > 0 then
                -- Apply controlled velocity interpolation to dodge server-side velocity discrepancy flags
                local currentVel = hrp.Velocity
                local targetVel = Vector3.new(humanoid.MoveDirection.X * (16 * Config.SpeedChanger.Multiplier), currentVel.Y, humanoid.MoveDirection.Z * (16 * Config.SpeedChanger.Multiplier))
                hrp.Velocity = targetVel
            end
        end
    end

    -- Real-time Room Scanner & Entity Notifier
    local currentRoom = Workspace:FindFirstChild("Rooms") or Workspace:FindFirstChild("CurrentRooms")
    if currentRoom then
        local entityDetected = false
        
        for _, room in ipairs(currentRoom:GetChildren()) do
            -- Entity check (Rush, Ambush, Figure, Seek, etc.)
            for _, child in ipairs(room:GetDescendants()) do
                if Config.EntityNotifier then
                    if child.Name == "RushMoving" or child.Name == "AmbushMoving" or child.Name == "Eyes" or child.Name == "SeekMoving" then
                        entityDetected = true
                        NotifierLabel.Text = "WARNING: Entity Approaching (" .. child.Name .. ")!"
                    end
                end
                
                -- ESP Logic
                if Config.ESP.Doors and (child.Name == "Door" or child.Name == "Doored") then
                    local doorPart = child:FindFirstChild("Door") or child
                    if doorPart:IsA("BasePart") then
                        createHighlight(doorPart, Color3.fromRGB(0, 170, 255))
                    end
                elseif Config.ESP.Keys and (child.Name == "Key" or child.Name == "KeyObtain") then
                    createHighlight(child, Color3.fromRGB(255, 220, 0))
                end
            end
        end
        
        if Config.EntityNotifier and not entityDetected then
            NotifierLabel.Text = "Status: Area Clear. Scanning..."
        end
    end
end)
